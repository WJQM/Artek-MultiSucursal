generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  /// Ubicación en el mapa (portal: mapa y "Cómo llegar"; WhatsApp de "listo para recoger")
  latitude  Float?
  longitude Float?
  /// Horario de atención (JSON: { week, sat, sun } con { from, to } o null = cerrado)
  hours     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  repairs   Repair[]
  services      Service[]
  inventoryItems InventoryItem[]
  software      Software[]
  quotations    Quotation[]
  notifications Notification[]
  messages      Message[]
  certificates  Certificate[]
  equipment     Equipment[]
  videogames    Videogame[]
  consoles      Console[]
  appointments  Appointment[]
  reservations  Reservation[]
  reservationWaits ReservationWait[]
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  password        String
  role            String         @default("admin")
  status          String         @default("active")
  phone           String?
  image           String?
  branchId        String?
  createdAt       DateTime       @default(now())
  // Seguridad de acceso
  tokenVersion       Int       @default(0)     // +1 invalida todas las sesiones abiertas
  phoneVerified      Boolean   @default(false)
  twoFactorEnabled   Boolean   @default(false) // técnicos: PIN opcional (admins siempre)
  totpSecret         String?                   // app autenticadora (cifrado)
  totpEnabled        Boolean   @default(false)
  totpLastStep       Int?                      // último intervalo TOTP aceptado (evita reusar un código)
  backupCodes        String?                   // JSON con hashes de códigos de respaldo
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  branch          Branch?        @relation(fields: [branchId], references: [id])
  notifications   Notification[]
  assignedRepairs Repair[]       @relation("AssignedRepairs")
  repairs         Repair[]       @relation("CreatedRepairs")
  quotations      Quotation[]
  messages        Message[]
  certificates    Certificate[]
}

model Repair {
  id            String    @id @default(uuid())
  code          String
  device        String
  issue         String
  status        String    @default("pending")
  priority      String    @default("media")
  estimatedCost Float     @default(0)
  notes         String?
  qrCode        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        String
  branchId      String
  image         String?
  brand         String?
  clientEmail   String?
  clientName    String?
  clientPhone   String?
  model         String?
  accessories   String?
  technicianId  String?
  deliveredAt   DateTime? // fecha real de entrega (para ingresos por fecha)
  /// Cómo pagó el cliente al entregar: "cash" (efectivo) | "qr". Vacío = sin indicar (se cuenta como efectivo)
  paidWith      String?
  /// IMEI del celular (15 dígitos) o número de serie
  imei          String?
  /// Resultado de la consulta pagada de IMEI (JSON: modelo, reporte de robo, bloqueo…)
  imeiCheck     String?   @db.Text
  imeiCheckedAt DateTime?
  /// Repuestos usados (JSON: [{ itemId, name, qty, price, cost }]); el stock se descuenta en el servidor
  parts         String?   @db.Text
  /// Costo de compra de los repuestos (para la ganancia)
  partsCost     Float     @default(0)
  signature     String?   @db.Text // firma del cliente al entregar (PNG en data URL)
  signedAt      DateTime?
  warrantyOf    String?   // código de la OT original cuando es un reingreso por garantía (misma sucursal)
  remindedAt    DateTime? // último recordatorio "listo para recoger" enviado
  reminders     Int       @default(0)
  technician    User?     @relation("AssignedRepairs", fields: [technicianId], references: [id])
  user          User      @relation("CreatedRepairs", fields: [userId], references: [id])
  branch        Branch    @relation(fields: [branchId], references: [id])
  messages      Message[]
  logs          RepairLog[]

  @@unique([code, branchId])
  @@unique([qrCode, branchId])
  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@index([technicianId])
  @@index([clientName])
  @@index([clientPhone])
  @@index([branchId, deliveredAt])
  @@index([imei])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  branchId  String
  user      User     @relation(fields: [userId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([userId, read])
  @@index([branchId, createdAt])
}

model Service {
  id        String   @id @default(cuid())
  name      String
  price     Float
  icon      String   @default("🔧")
  active    Boolean  @default(true)
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model InventoryItem {
  id        String       @id @default(cuid())
  name      String
  category  String?
  quantity  Int          @default(0)
  price     Float        @default(0)
  /// Precio de compra (para calcular la ganancia). 0 = sin cargar
  cost      Float        @default(0)
  minStock  Int          @default(5)
  active    Boolean      @default(true)
  /// false = no se muestra en el portal público (sigue en el inventario interno)
  showInPortal Boolean   @default(true)
  /// "product" = producto a la venta (Inventario) · "part" = repuesto (pestaña Repuestos)
  kind      String       @default("product")
  branchId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  image     String?
  serials   SerialUnit[]
  movements StockMovement[]
  branch    Branch       @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model SerialUnit {
  id              String        @id @default(cuid())
  serialNumber    String        @unique
  status          String        @default("available")
  inventoryItemId String
  soldTo          String?
  soldAt          DateTime?
  repairCode      String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  item            InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model Software {
  id              String   @id @default(cuid())
  name            String
  category        String?
  image           String?
  active          Boolean  @default(true)
  branchId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  minRequirements String?
  recRequirements String?
  size            String?
  description     String?
  language        String?
  rating          String?
  branch          Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
  /// false = no se muestra en el portal público
  showInPortal Boolean @default(true)
  /// Precio opcional (Bs.): vacío = no se muestra y no aparece en cotizaciones
  price Float?
}

model Quotation {
  id          String   @id @default(cuid())
  code        String
  type        String   @default("quotation")
  clientName  String
  clientPhone String?
  items       String
  total       Float    @default(0)
  notes       String?
  /// Notas de venta: "cash" (efectivo) | "qr". Vacío = sin indicar
  paidWith    String?
  /// Costo de compra de lo vendido (ventas) y si todos los artículos tenían costo cargado
  costTotal   Float    @default(0)
  costComplete Boolean @default(true)
  branchId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  branch      Branch   @relation(fields: [branchId], references: [id])

  @@unique([code, branchId])
  @@index([branchId, type, createdAt])
}

/// Chat interno del personal. Con repairId = conversación de esa orden; sin repairId = chat general de la sucursal.
model Message {
  id        String   @id @default(uuid())
  text      String
  /// JSON: lista de URLs de fotos
  images    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  repairId  String?
  userId    String
  branchId  String
  repair    Repair?  @relation(fields: [repairId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([repairId])
  @@index([branchId])
  @@index([branchId, createdAt])
}

/// Hasta cuándo leyó cada persona cada conversación del chat ("r:<orden>" o "b:<sucursal>")
model ChatRead {
  id         String   @id @default(cuid())
  userId     String
  threadKey  String
  lastReadAt DateTime

  @@unique([userId, threadKey])
}

model Certificate {
  id             String   @id @default(cuid())
  code           String
  clientName     String
  computerName   String?
  windowsEdition String?
  windowsSerial  String?
  officeEdition  String?
  officeSerial   String?
  date           String
  technician     String
  notes          String?
  branchId       String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch   @relation(fields: [branchId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@unique([code, branchId])
  @@index([branchId, createdAt])
}

model Equipment {
  id            String   @id @default(cuid())
  code          String   @default("")
  name          String
  type          String   @default("laptop") // laptop | desktop
  brand         String?
  model         String?
  processor     String?
  ram           String?
  storage       String?
  storage2      String?
  screenSize    String?
  graphicsCard  String?
  os            String?
  cabinet       String?
  powerSupply   String?
  motherboard   String?
  accessories   String?
  condition     String   @default("disponible") // disponible | vendido | en_reparacion
  price         Float    @default(0)
  notes         String?
  image         String?
  branchId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branch        Branch   @relation(fields: [branchId], references: [id])

  @@unique([code, branchId])
  @@index([branchId])
  @@index([branchId, type])
  /// false = no se muestra en el portal público
  showInPortal Boolean @default(true)
}

model Settings {
  id          String   @id @default("global")
  companyName String   @default("RepairTrackQR")
  slogan      String   @default("Servicio Técnico Especializado")
  logo        String?
  phone       String?
  email       String?
  address     String?
  website     String?
  city        String?
  warrantyDays Int     @default(30)
  abandonDays  Int     @default(90)
  terms        String?
  publicUrl    String?
  updatedAt   DateTime @updatedAt
}

model Videogame {
  id              String   @id @default(cuid())
  name            String
  platform        String?  // PC, Nintendo Switch, Nintendo Wii, PSP, PS Vita... (ampliable)
  genre           String?  // Acción, RPG, Deportes, etc.
  description     String?
  size            String?  // "50 GB", "1.2 GB"
  minRequirements String?  // Solo aplica a PC — opcional
  recRequirements String?
  language        String?  // Español, Inglés, Multi, etc.
  rating          String?  // PEGI-18, ESRB-M, PEGI-7, etc.
  image           String?  // JSON array de URLs o URL única
  active          Boolean  @default(true)
  branchId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  branch          Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([branchId, platform])
  /// false = no se muestra en el portal público
  showInPortal Boolean @default(true)
  /// Precio opcional (Bs.): vacío = no se muestra y no aparece en cotizaciones
  price Float?
}

model Console {
  id            String   @id @default(cuid())
  code          String   @default("")
  name          String
  category      String?  // Nintendo, Sony, Microsoft... (ampliable)
  state         String?  // "nueva" | "usada"
  brand         String?
  model         String?
  color         String?
  storage       String?
  generation    String?
  accessories   String?
  condition     String   @default("disponible") // disponible | vendida | reservada
  price         Float    @default(0)
  notes         String?
  image         String?
  active        Boolean  @default(true)
  branchId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branch        Branch   @relation(fields: [branchId], references: [id])

  @@unique([code, branchId])
  @@index([branchId])
  @@index([branchId, category])
  @@index([branchId, condition])
  /// false = no se muestra en el portal público
  showInPortal Boolean @default(true)
}

// Registro de visitas al portal público
model PageView {
  id           String   @id @default(cuid())
  path         String   // "/portal", "/track/OT-5", "/certificate-view/CE-3"
  documentType String?  // "ot" | "ce" | "cot" | "nv" | "eq" | "cn" | "cl" | null
  documentCode String?  // "OT-5", "CE-3", null si es portal principal
  ipHash       String?  // SHA-256 de IP (para uniqueness sin PII)
  userAgent    String?  // Browser info (truncado a 300 chars)
  referrer     String?  // URL de donde vino
  branchId     String?  // Si se pudo asociar a una sucursal
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([documentType, createdAt])
  @@index([documentCode])
  @@index([path, createdAt])
}

// Historial de cambios de estado de OTs
model StatusHistory {
  id          String   @id @default(cuid())
  repairId    String
  fromStatus  String?  // null si es el estado inicial
  toStatus    String
  changedBy   String?  // userId que hizo el cambio
  changedByName String? // nombre del usuario (cacheado)
  notes       String?  // comentario opcional
  createdAt   DateTime @default(now())

  @@index([repairId, createdAt])
}

// Caja chica: movimientos de dinero (ingresos y egresos)
model CashMovement {
  id          String   @id @default(cuid())
  type        String   // "income" | "expense"
  category    String   // "repuestos" | "servicios" | "pagos" | "ventas" | "otros" | "ajuste"
  amount      Float
  description String
  notes       String?
  createdBy   String?  // userId
  createdByName String? // nombre usuario cacheado
  branchId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId, createdAt])
  @@index([branchId, type, createdAt])
}

// Reseñas/calificaciones del cliente al entregar OT
model Review {
  id          String   @id @default(cuid())
  repairId    String   @unique
  repairCode  String   // OT-X
  rating      Int      // 1-5 estrellas
  comment     String?
  clientName  String?
  branchId    String
  createdAt   DateTime @default(now())

  @@index([branchId, createdAt])
  @@index([rating])
}

/// Celulares/computadoras que activaron los avisos (Web Push). Uno por navegador.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  device     String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

model KeyValue {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// PIN de un solo uso (WhatsApp) para login, registro, recuperación y cambio de celular
model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  purpose    String    // "login" | "register" | "reset" | "phone"
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, createdAt])
}

// "Recordar este dispositivo" (no pedir PIN por 30 días)
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Bitácora de la reparación: hallazgos, avances, problemas e informe final con fotos.
/// visibleToClient = se muestra en el seguimiento del cliente (con el nombre del autor).
model RepairLog {
  id              String   @id @default(cuid())
  repairId        String
  branchId        String
  authorId        String
  authorName      String
  authorRole      String
  /// hallazgo | avance | problema | final | comentario
  type            String
  text            String
  /// JSON: lista de URLs de fotos
  images          String?
  visibleToClient Boolean  @default(false)
  /// Estado de la orden cuando se escribió (pending, diagnosed, …)
  status          String?
  /// Si un administrador lo registró a nombre del técnico: quién lo escribió realmente
  recordedById    String?
  recordedByName  String?
  /// Ocultada por un administrador (no se borra, queda como respaldo)
  hidden          Boolean  @default(false)
  hiddenById      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  repair          Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([repairId, createdAt])
  @@index([branchId, createdAt])
}

/// Citas reservadas por clientes desde el portal (o anotadas por el personal)
model Appointment {
  id          String    @id @default(cuid())
  /// CITA-1, CITA-2… por sucursal
  code        String
  branchId    String
  /// Fecha y hora de la cita
  date        DateTime
  clientName  String
  clientPhone String
  device      String
  issue       String?
  /// new (nueva) | confirmed | cancelled | done (llegó, se creó la orden) | noshow (no vino)
  status      String    @default("new")
  /// "client" | "staff" (quién la canceló)
  cancelledBy String?
  /// Orden creada cuando el cliente llegó
  repairId    String?
  /// "portal" | "staff"
  source      String    @default("portal")
  remindedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branch      Branch    @relation(fields: [branchId], references: [id])

  @@unique([code, branchId])
  @@index([branchId, date])
  @@index([clientPhone])
}

/// Historial de movimientos de stock (ventas, repuestos de órdenes, ajustes manuales…)
model StockMovement {
  id        String        @id @default(cuid())
  itemId    String
  branchId  String
  /// + entra / − sale
  delta     Int
  /// Cantidad que quedó
  after     Int
  /// sale | sale_edit | sale_delete | repair | manual | serial | transfer | create
  reason    String
  refCode   String?
  refId     String?
  userId    String?
  userName  String?
  createdAt DateTime      @default(now())
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@index([branchId, createdAt])
}

/// Cierre de caja del día: lo que debería haber en efectivo vs lo contado
model CashClosing {
  id            String   @id @default(cuid())
  branchId      String
  /// Día que se cierra (AAAA-MM-DD, hora del negocio)
  day           String
  openingFloat  Float    @default(0)
  cashRepairs   Float    @default(0)
  cashSales     Float    @default(0)
  cashIn        Float    @default(0)
  cashOut       Float    @default(0)
  expected      Float    @default(0)
  counted       Float    @default(0)
  /// counted − expected (negativo = falta)
  difference    Float    @default(0)
  /// JSON { "200": 8, "100": 7, … } si se contó por billete
  denominations String?
  leftInCash    Float    @default(0)
  withdrawn     Float    @default(0)
  qrTotal       Float    @default(0)
  qrVerified    Boolean  @default(false)
  notes         String?
  userId        String?
  userName      String?
  createdAt     DateTime @default(now())

  @@unique([branchId, day])
  @@index([branchId, createdAt])
}

/// Apartado desde el portal (AP-1, AP-2… por sucursal). El stock real no se descuenta hasta venderlo.
model Reservation {
  id          String    @id @default(cuid())
  code        String
  branchId    String
  /// inventory (productos y repuestos) | equipment | console
  kind        String
  itemId      String
  itemName    String
  price       Float     @default(0)
  qty         Int       @default(1)
  total       Float     @default(0)
  clientName  String
  clientPhone String
  /// active | sold | expired | cancelled
  status      String    @default("active")
  expiresAt   DateTime
  /// Veces que el personal le dio más tiempo
  extended    Int       @default(0)
  /// Nota de venta creada al venderlo
  saleId      String?
  saleCode    String?
  /// "client" | "staff" | "system" (sin stock)
  cancelledBy String?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branch      Branch    @relation(fields: [branchId], references: [id])

  @@unique([code, branchId])
  @@index([status, expiresAt])
  @@index([itemId, status])
  @@index([clientPhone])
}

/// Lista de espera: aviso por WhatsApp cuando un producto apartado se libera
model ReservationWait {
  id          String    @id @default(cuid())
  branchId    String
  kind        String
  itemId      String
  itemName    String
  clientName  String?
  clientPhone String
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  branch      Branch    @relation(fields: [branchId], references: [id])

  @@unique([kind, itemId, clientPhone])
  @@index([itemId, notifiedAt])
}
