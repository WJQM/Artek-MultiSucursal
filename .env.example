# PostgreSQL - Base de datos
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/repairtrack"

# JWT Secret - OBLIGATORIO, mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# (SETUP_CODE ya no se usa: el Super Admin entra con contraseña + PIN de WhatsApp.
#  Los Super Admin nuevos se crean desde Administración → Usuarios.)

# WasenderApi - WhatsApp (opcional)
WASENDER_API_KEY="tu-api-key-de-wasender"

# Avisos en el celular (opcional): si no se ponen, el sistema genera sus propias claves la primera vez
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# (Cada empresa necesita SU PROPIA cuenta de WasenderAPI: los mensajes salen del número conectado a esa clave)

# Dirección pública del sistema, la que reciben los clientes por WhatsApp (…/portal).
# Recomendado en el servidor, p. ej. APP_URL="https://taller.midominio.com". Si se deja vacío se usa el dominio de la petición.
# APP_URL=""

# Solo si tu servidor NO tiene HTTPS todavía (acceso por IP con http://).
# Sin esto la cookie de sesión no se guarda y el panel te devuelve al login.
# COOKIE_INSECURE=1

# Cifra el secreto de las apps autenticadoras (Google/Microsoft Authenticator).
# Genéralo una vez y NO lo cambies después (las apps configuradas dejarían de funcionar):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si lo dejas vacío se usa JWT_SECRET (entonces tampoco cambies JWT_SECRET).
ENCRYPTION_KEY=""

# Cloudflare Turnstile (captcha anti-bots en login, registro, /setup y recuperación).
# Gratis en https://dash.cloudflare.com → Turnstile → Add widget. Vacío = desactivado.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Zona horaria del negocio (opcional, por defecto America/La_Paz)
# APP_TIMEZONE="America/La_Paz"

# Carpeta donde se guardan las imágenes subidas (usuarios, productos, logo...).
# Vacío = public/uploads dentro del proyecto. En el servidor usa una carpeta FUERA
# del proyecto para que las fotos no se pierdan al actualizar la app:
# UPLOAD_DIR="/var/lib/repairtrack/uploads"
UPLOAD_DIR=""
